{
  "name": "todo-tree-checker-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "todo-check": "todo-check --path src --target todo --target fixme"
  },
  "todoTreeChecker": {
    "paths": ["src"],
    "targets": ["todo", "fixme"],
    "pretty": true,
    "failOnMatch": true
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "todo-tree-checker": "file:.."
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
